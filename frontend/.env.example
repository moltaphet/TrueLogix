# Optional: wire the dashboard to a deployed TrueLogix contract via genlayer-js.
# Leave unset to use the built-in client-side simulation.

# Deployed contract address (0x + 40 hex chars)
VITE_GENLAYER_CONTRACT=

# Target network: studionet | testnet_asimov | localnet
VITE_GENLAYER_NETWORK=studionet
